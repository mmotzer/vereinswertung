# In Portainer unter Environment variables setzen. Niemals echte Schlüssel veröffentlichen.
BOOTSTRAP_TOKEN=HIER_EINEN_ZUFAELLIGEN_SCHLUESSEL_MIT_MINDESTENS_32_ZEICHEN_SETZEN
SECURE_COOKIE=true
# Später z. B. https://wertung.dein-verein.de (ohne abschließenden Schrägstrich).
# Leer = Origin muss zum Host der Anfrage passen.
PUBLIC_ORIGIN=
# Nur für den optionalen Tunnel-Stack:
TUNNEL_TOKEN=DEIN_CLOUDFLARE_TUNNEL_TOKEN
